        CONFIG["config.py (section 1)<br/>Settings.from_env()"]
    end

    SQLITE[("SQLite file<br/>LINKS_DB_PATH, table links")]

    MAIN --> CONFIG
    MAIN --> DB
    MAIN --> REPO
    MAIN --> CODES
    MAIN --> SERVICE
